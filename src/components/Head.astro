---
import { template } from '@/settings'
import { withBase } from '@/lib/paths'
import { alternatePath, getLocale, hasTranslation } from '@/lib/i18n'

interface Props {
	title: string
	description: string
	image: string
}

const { title, description, image } = Astro.props
const locale = getLocale(Astro.url.pathname)
const isTranslated = hasTranslation(Astro.url.pathname)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)
const englishURL = new URL(alternatePath(Astro.url.pathname, 'en'), Astro.site)
const chineseURL = new URL(alternatePath(Astro.url.pathname, 'zh'), Astro.site)
---

<meta charset='utf-8' />
<meta name='viewport' content='width=device-width, initial-scale=1' />
<meta name='theme-color' content='#0f766e' />
<meta name='generator' content={Astro.generator} />
<link rel='icon' type='image/svg+xml' href={withBase('/favicon.svg')} />
<link rel='alternate' type='application/rss+xml' title={`${title} RSS`} href={withBase('/rss.xml')} />
<link rel='sitemap' href={withBase('/sitemap-index.xml')} />
<link rel='canonical' href={canonicalURL} />
{isTranslated && <link rel='alternate' hreflang='en' href={englishURL} />}
{isTranslated && <link rel='alternate' hreflang='zh-CN' href={chineseURL} />}
{isTranslated && <link rel='alternate' hreflang='x-default' href={englishURL} />}

<title>{title}</title>
<meta name='title' content={title} />
<meta name='description' content={description} />

<meta property='og:type' content='website' />
<meta property='og:url' content={canonicalURL} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:image' content={socialImage} />
<meta property='og:site_name' content='Yufei Zhang' />
<meta property='og:locale' content={locale === 'zh' ? 'zh_CN' : 'en_US'} />

<meta name='twitter:card' content='summary' />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={socialImage} />

<script is:inline define:vars={{ lightTheme: template.lightTheme }}>
	const storedTheme = localStorage.getItem('theme') || lightTheme
	document.documentElement.setAttribute('data-theme', storedTheme)
	document.addEventListener('astro:after-swap', () => {
		document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || lightTheme)
	})
</script>
