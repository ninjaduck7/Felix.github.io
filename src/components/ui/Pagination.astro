---
const { page } = Astro.props
---

<nav class='join flex justify-center' aria-label='Notes pagination'>
	{page.url.prev ? (
		<a href={page.url.prev} class='join-item btn btn-sm' aria-label='Previous page'>Previous</a>
	) : (
		<span class='join-item btn btn-disabled btn-sm' aria-hidden='true'>Previous</span>
	)}
	{page.url.next ? (
		<a href={page.url.next} class='join-item btn btn-sm' aria-label='Next page'>Next</a>
	) : (
		<span class='join-item btn btn-disabled btn-sm' aria-hidden='true'>Next</span>
	)}
</nav>
