---
import { alternatePath, getLocale, hasTranslation } from '@/lib/i18n'

const locale = getLocale(Astro.url.pathname)
const isTranslated = hasTranslation(Astro.url.pathname)
const targetLocale = locale === 'en' ? 'zh' : 'en'
const label = locale === 'en' ? '中文' : 'EN'
const title = locale === 'en' ? '切换到中文' : 'Switch to English'
---

{isTranslated && (
	<a
		href={alternatePath(Astro.url.pathname, targetLocale)}
		hreflang={targetLocale === 'zh' ? 'zh-CN' : 'en'}
		lang={targetLocale === 'zh' ? 'zh-CN' : 'en'}
		class='btn btn-ghost btn-sm border border-base-300 font-medium'
		title={title}
		aria-label={title}
	>
		{label}
	</a>
)}
