---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import ProfilePicture from '@/assets/profile-picture.png'
import SocialIcons from '@/components/ui/SocialIcons.astro'
import DarkLightController from '@/components/ui/DarkLightController.astro'
import LanguageSwitch from '@/components/ui/LanguageSwitch.astro'
import { profile, profileZh } from '@/settings'
import { getLocale, localizedPath } from '@/lib/i18n'

const isBlogPopulated = await getCollection('blog', ({ data }) => !data.draft).then((collection) => collection.length > 0)
const locale = getLocale(Astro.url.pathname)
const isZh = locale === 'zh'
const currentProfile = isZh ? profileZh : profile
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const navItems = [
	{ label: isZh ? '首页' : 'Home', path: '/' },
	{ label: isZh ? '研究' : 'Research', path: '/research' },
	{ label: isZh ? '论文' : 'Publications', path: '/papers' },
	{ label: isZh ? '项目' : 'Projects', path: '/projects' },
	{ label: isZh ? '简历' : 'CV', path: '/cv' },
	...(isBlogPopulated ? [{ label: isZh ? '笔记' : 'Notes', path: isZh ? '/blog/1' : '/blog/1' }] : []),
]
---

<aside class='flex h-screen w-[18rem] flex-col border-r border-base-300 bg-base-200 px-6 py-7 text-base-content'>
	<div class='flex min-h-0 flex-1 flex-col'>
		<a href={localizedPath('/', locale)} class='group block'>
			<Image
				class='size-24 rounded-md object-cover ring-1 ring-base-300 transition group-hover:ring-primary'
				src={ProfilePicture}
				width={192}
				height={192}
				alt={isZh ? `${currentProfile.fullName}的个人照片` : `Portrait of ${currentProfile.fullName}`}
			/>
			<p class='mt-5 font-serif text-2xl font-bold leading-tight'>{currentProfile.fullName}</p>
			<p class='mt-2 text-sm leading-6 text-base-content/70'>{currentProfile.title}</p>
		</a>

		<nav class='mt-9 min-h-0 overflow-y-auto' aria-label={isZh ? '主导航' : 'Primary navigation'}>
			<ul class='menu w-full gap-1 p-0'>
				{navItems.map((item) => {
					const href = localizedPath(item.path, locale)
					const normalizedHref = href.replace(/\/$/, '')
					const isActive = item.path === '/'
						? currentPath === normalizedHref
						: currentPath.startsWith(normalizedHref)

					return (
						<li>
							<a
								href={href}
								aria-current={isActive ? 'page' : undefined}
								class:list={[
									'rounded px-3 py-2.5 text-[0.95rem] font-medium',
									isActive ? 'bg-base-300 text-primary' : 'hover:bg-base-300',
								]}
							>
								{item.label}
							</a>
						</li>
					)
				})}
			</ul>
		</nav>
	</div>

	<div class='border-t border-base-300 pt-5'>
		<div class='mb-4 flex items-center justify-between'>
			<span class='font-mono text-xs uppercase text-base-content/60'>{currentProfile.location}</span>
			<div class='hidden items-center gap-2 lg:flex'>
				<LanguageSwitch />
				<DarkLightController />
			</div>
		</div>
		<SocialIcons />
	</div>
</aside>
