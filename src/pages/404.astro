---
import Layout from '@/layouts/Layout.astro'
import { withBase } from '@/lib/paths'
---

<Layout title='Page not found | Yufei Zhang'>
	<section class='flex min-h-[65vh] flex-col justify-center'>
		<p class='section-kicker mb-5'>Error 404</p>
		<h1 class='font-serif text-5xl font-bold sm:text-6xl'>Page not found</h1>
		<p class='mt-5 max-w-xl text-lg leading-8 text-base-content/75'>
			The requested page does not exist or has moved.
		</p>
		<div class='mt-8 flex flex-wrap gap-3'>
			<a href={withBase('/')} class='btn btn-primary'>Return home</a>
			<button class='btn btn-ghost border border-base-300' onclick='history.back()'>Go back</button>
		</div>
	</section>
</Layout>
