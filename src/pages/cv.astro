---
import Layout from '@/layouts/Layout.astro'
import { education, experiences, publications, skills } from '@/data/cv'

const sections = [
	{ label: 'Education', count: education.length },
	{ label: 'Experience', count: experiences.length },
	{ label: 'Publications', count: publications.length },
]
---

<Layout title='CV | Yufei Zhang' description='Curriculum vitae of Yufei Zhang.'>
	<header class='max-w-3xl border-b border-base-300 pb-10'>
		<p class='section-kicker mb-4'>Curriculum vitae</p>
		<h1 class='font-serif text-4xl font-bold sm:text-5xl'>Yufei Zhang</h1>
		<p class='mt-6 text-lg leading-8 text-base-content/75'>
			Ph.D. student in physics at Beijing Institute of Technology, studying quantum-inspired algorithms, combinatorial optimization, diffusion stochastic processes, and learning-based operations research.
		</p>
	</header>

	<div class='grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_15rem]'>
		<div class='space-y-14'>
			<section aria-labelledby='education-heading'>
				<h2 id='education-heading' class='font-serif text-2xl font-bold'>Education</h2>
				<div class='mt-6 divide-y divide-base-300 border-y border-base-300'>
					{education.map((item) => (
						<article class='grid gap-3 py-6 sm:grid-cols-[9rem_minmax(0,1fr)]'>
							<time class='font-mono text-xs text-primary'>{item.time}</time>
							<div>
								<h3 class='font-serif text-xl font-bold'>{item.school}</h3>
								<p class='mt-1 font-medium'>{item.degree}</p>
								<p class='mt-2 text-sm text-base-content/60'>{item.location}</p>
								{item.description && <p class='mt-4 leading-7 text-base-content/75'>{item.description}</p>}
							</div>
						</article>
					))}
				</div>
			</section>

			<section aria-labelledby='skills-heading'>
				<h2 id='skills-heading' class='font-serif text-2xl font-bold'>Skills and methods</h2>
				<div class='mt-6 grid gap-px overflow-hidden rounded-md border border-base-300 bg-base-300 sm:grid-cols-2'>
					{skills.map((skill) => (
						<article class='bg-base-100 p-6'>
							<h3 class='font-serif text-lg font-bold'>{skill.title}</h3>
							<p class='mt-2 leading-7 text-base-content/75'>{skill.description}</p>
						</article>
					))}
				</div>
			</section>

			{experiences.length === 0 && (
				<section class='border-l-2 border-accent pl-6'>
					<h2 class='font-serif text-xl font-bold'>CV details to complete</h2>
					<p class='mt-3 leading-7 text-base-content/75'>
						TODO: add verified research appointments, awards, talks, and service.
					</p>
				</section>
			)}
		</div>

		<aside class='lg:border-l lg:border-base-300 lg:pl-7'>
			<p class='section-kicker mb-4'>At a glance</p>
			<dl class='space-y-4'>
				{sections.map((section) => (
					<div class='flex items-center justify-between gap-4 border-b border-base-300 pb-3'>
						<dt>{section.label}</dt>
						<dd class='font-mono text-sm text-primary'>{section.count}</dd>
					</div>
				))}
			</dl>
		</aside>
	</div>
</Layout>
