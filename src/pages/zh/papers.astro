---
import Layout from '@/layouts/Layout.astro'
import { publications } from '@/data/cv'
import { highlightAuthor } from '@/lib/utils'
---

<Layout title='论文 | Yufei Zhang' description='Yufei Zhang 经核实的学术论文列表。'>
	<header class='max-w-3xl border-b border-base-300 pb-10'>
		<p class='section-kicker mb-4'>学术成果</p>
		<h1 class='font-serif text-4xl font-bold sm:text-5xl'>论文</h1>
		<p class='mt-6 text-lg leading-8 text-base-content/75'>
			本页只收录标题、作者顺序、发表载体、日期与原始链接均已核实的学术成果。
		</p>
	</header>

	{publications.length > 0 ? (
		<ol class='divide-y divide-base-300'>
			{publications.map((paper, index) => (
				<li class='grid gap-5 py-9 md:grid-cols-[3rem_minmax(0,1fr)]'>
					<p class='font-mono text-xs font-bold text-primary'>{String(index + 1).padStart(2, '0')}</p>
					<article>
						<h2 class='font-serif text-2xl font-bold'>
							{paper.link ? <a href={paper.link} target='_blank' rel='noreferrer' class='hover:text-primary'>{paper.title}</a> : paper.title}
						</h2>
						<p class='mt-3' set:html={highlightAuthor(paper.authors)} />
						<p class='mt-2 text-sm text-base-content/65'>{paper.journal} / {paper.time}</p>
						{paper.abstract && <p class='mt-5 leading-7 text-base-content/75'>{paper.abstract}</p>}
					</article>
				</li>
			))}
		</ol>
	) : (
		<section class='my-12 border-l-2 border-accent py-2 pl-6'>
			<h2 class='font-serif text-2xl font-bold'>详细信息待核实</h2>
			<p class='mt-3 max-w-2xl leading-7 text-base-content/75'>
				论文信息将在书目元数据和权威链接确认后补充，本页不展示未经核实的占位内容。
			</p>
		</section>
	)}
</Layout>
